  "clips": [
    {
      "file": "00-0.mp3",
      "text": "श्री गुरु चरन सरोज रज, निज मनु मुकुरु सुधारि।",
      "duration": 4.224
    },
    {
      "file": "00-1.mp3",
      "text": "बरनउँ रघुबर बिमल जसु, जो दायकु फल चारि॥",
      "duration": 4.096
    },
    {
      "file": "01-0.mp3",
      "text": "बुद्धिहीन तनु जानिके, सुमिरौं पवन कुमार।",
      "duration": 3.733
    },
    {
      "file": "01-1.mp3",
      "text": "बल बुधि बिद्या देहु मोहिं, हरहु कलेस बिकार॥",
      "duration": 3.925
    },
    {
      "file": "02-0.mp3",
      "text": "जय हनुमान ज्ञान गुन सागर।",
      "duration": 2.709
    },
    {
      "file": "02-1.mp3",
      "text": "जय कपीस तिहुँ लोक उजागर॥",
      "duration": 2.475
    },
    {
      "file": "03-0.mp3",
      "text": "राम दूत अतुलित बल धामा।",
      "duration": 2.496
    },
    {
      "file": "03-1.mp3",
      "text": "अंजनि पुत्र पवनसुत नामा॥",
      "duration": 2.56
    },
    {
      "file": "04-0.mp3",
      "text": "महाबीर बिक्रम बजरंगी।",
      "duration": 2.56
    },
    {
      "file": "04-1.mp3",
      "text": "कुमति निवार सुमति के संगी॥",
      "duration": 2.709
    },
    {
      "file": "05-0.mp3",
      "text": "कंचन बरन बिराज सुबेसा।",
      "duration": 2.539
    },
    {
      "file": "05-1.mp3",
      "text": "कानन कुंडल कुंचित केसा॥",
      "duration": 2.304
    },
    {
      "file": "06-0.mp3",
      "text": "हाथ बज्र औ ध्वजा बिराजै।",
      "duration": 2.581
    },
    {
      "file": "06-1.mp3",
      "text": "काँधे मूँज जनेऊ साजै॥",
      "duration": 2.133
    },
    {
      "file": "07-0.mp3",
      "text": "शंकर सुवन केसरी नंदन।",
      "duration": 2.496
    },
    {
      "file": "07-1.mp3",
      "text": "तेज प्रताप महा जग बंदन॥",
      "duration": 2.496
    },
    {
      "file": "08-0.mp3",
      "text": "बिद्यावान गुनी अति चातुर।",
      "duration": 2.496
    },
    {
      "file": "08-1.mp3",
      "text": "राम काज करिबे को आतुर॥",
      "duration": 2.347
    },
    {
      "file": "09-0.mp3",
      "text": "प्रभु चरित्र सुनिबे को रसिया।",
      "duration": 2.773
    },
    {
      "file": "09-1.mp3",
      "text": "राम लखन सीता मन बसिया॥",
      "duration": 2.645
    },
    {
      "file": "10-0.mp3",
      "text": "सूक्ष्म रूप धरि सियहिं दिखावा।",
      "duration": 2.688
    },
    {
      "file": "10-1.mp3",
      "text": "बिकट रूप धरि लंक जरावा॥",
      "duration": 2.645
    },
    {
      "file": "11-0.mp3",
      "text": "भीम रूप धरि असुर सँहारे।",
      "duration": 2.667
    },
    {
      "file": "11-1.mp3",
      "text": "रामचंद्र के काज सँवारे॥",
      "duration": 2.517
    },
    {
      "file": "12-0.mp3",
      "text": "लाय सजीवन लखन जियाए।",
      "duration": 2.304
    },
    {
      "file": "12-1.mp3",
      "text": "श्री रघुबीर हरषि उर लाए॥",
      "duration": 2.645
    },
    {
      "file": "13-0.mp3",
      "text": "रघुपति कीन्ही बहुत बड़ाई।",
      "duration": 2.475
    },
    {
      "file": "13-1.mp3",
      "text": "तुम मम प्रिय भरतहि सम भाई॥",
      "duration": 2.56
    },
    {
      "file": "14-0.mp3",
      "text": "सहस बदन तुम्हरो जस गावैं।",
      "duration": 2.752
    },
    {
      "file": "14-1.mp3",
      "text": "अस कहि श्रीपति कंठ लगावैं॥",
      "duration": 2.624
    },
    {
      "file": "15-0.mp3",
      "text": "सनकादिक ब्रह्मादि मुनीसा।",
      "duration": 2.581
    },
    {
      "file": "15-1.mp3",
      "text": "नारद सारद सहित अहीसा॥",
      "duration": 2.432
    },
    {
      "file": "16-0.mp3",
      "text": "जम कुबेर दिगपाल जहाँ ते।",
      "duration": 2.539
    },
    {
      "file": "16-1.mp3",
      "text": "कबि कोबिद कहि सके कहाँ ते॥",
      "duration": 2.539
    },
    {
      "file": "17-0.mp3",
      "text": "तुम उपकार सुग्रीवहिं कीन्हा।",
