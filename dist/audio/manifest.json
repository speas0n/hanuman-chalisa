    },
    {
      "file": "17-1.mp3",
      "text": "राम मिलाय राज पद दीन्हा॥",
      "duration": 2.411
    },
    {
      "file": "18-0.mp3",
      "text": "तुम्हरो मंत्र बिभीषन माना।",
      "duration": 2.603
    },
    {
      "file": "18-1.mp3",
      "text": "लंकेश्वर भए सब जग जाना॥",
