      "duration": 2.539
    },
    {
      "file": "20-0.mp3",
      "text": "प्रभु मुद्रिका मेलि मुख माहीं।",
      "duration": 2.773
    },
    {
      "file": "20-1.mp3",
      "text": "जलधि लाँघि गए अचरज नाहीं॥",
